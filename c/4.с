#include <stdio.h>
void swap_num(int* num1, int* num2)
{
    int mem;
    mem = *num1;
    *num1 = *num2;
    *num2 = mem;

}

int main()
{
    int num1, num2;
    printf("введите 2 значения");
    if (scanf("%d%d", &num1, &num2) != 2)
    {
        printf("введено не число!\n");
    }
    else
    {
        printf(" введено %d  %d.\n", num1, num2);
        swap_num(&num1, &num2);
        printf("1 число %d 2 число %d.\n", num1, num2);

    }
    return 0;
}
